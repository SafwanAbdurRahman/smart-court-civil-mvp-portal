# ─── Backend URL ────────────────────────────────────────────────────────────
# URL of the Python backend. This is visible in the browser bundle.
#
# Local development:
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
#
# Production (replace with your deployed backend URL):
# NEXT_PUBLIC_BACKEND_URL=https://your-backend.onrender.com

# Auth is now handled entirely by the backend's JWT login/register endpoints —
# there's no static API key to configure here anymore. Each browser session
# stores its own token after signing in.
