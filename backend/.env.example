# ─── Ollama (Local AI) ──────────────────────────────────────────────────────
# URL of your local (or remote) Ollama daemon.
OLLAMA_HOST=http://localhost:11434
# Model must already be pulled: `ollama pull gemma4:12b`
OLLAMA_MODEL=gemma4:12b

# ─── Auth ───────────────────────────────────────────────────────────────────
# Secret used to sign JWT session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left blank, a random one is generated at startup (dev-only — sessions
# won't survive a server restart). ALWAYS set this explicitly in production.
JWT_SECRET_KEY=
# How long a login session stays valid, in minutes. Default is 7 days.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Database ───────────────────────────────────────────────────────────────
# Defaults to a local SQLite file — swap for Postgres/MySQL in production,
# e.g. postgresql://user:password@host:5432/smartcourt
DATABASE_URL=sqlite:///./smartcourt.db

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Use * ONLY for local development.
# Production example: https://my-app.vercel.app,https://my-custom-domain.com
ALLOWED_ORIGINS=*

# ─── Ngrok (Development tunnel — disable in production) ──────────────────────
# Set USE_NGROK=True ONLY when running locally and you need a public URL.
# Get your token from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_TOKEN=your_ngrok_auth_token_here
USE_NGROK=False

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=8000
